{
  "name": "toc-nav",
  "version": "0.0.4",
  "description": "一个轻量级的目录导航组件，自动生成页面标题的可交互目录菜单",
  "keywords": [
    "toc",
    "table-of-contents"
  ],
  "author": "丁少华",
  "license": "MIT",
  "unpkg": "docs/dist/index.global.js",
  "jsdelivr": "docs/dist/index.global.js",
  "exports": {
    ".": {
      "types": "./docs/dist/index.d.ts",
      "import": "./docs/dist/index.mjs"
    },
    "./style.css": "./docs/dist/style.css"
  },
  "files": [
    "docs/dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently \"tsup --watch\" \"live-server docs\"",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "concurrently": "^9.2.1",
    "live-server": "^1.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}